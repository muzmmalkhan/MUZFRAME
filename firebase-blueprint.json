{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile containing basic info.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": ["admin", "client"]
        },
        "createdAt": {
          "type": "number"
        }
      },
      "required": ["email", "role", "createdAt"]
    },
    "Booking": {
      "title": "Booking Request",
      "description": "A booking request submitted from the contact page.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "package": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "confirmed", "completed", "cancelled"]
        },
        "createdAt": {
          "type": "number"
        }
      },
      "required": ["name", "date", "package", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Stores user profiles."
    },
    "/bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Stores booking requests."
    }
  }
}
